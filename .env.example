# ==============================================================================
# HackSeekho — Environment Configuration
# ==============================================================================
# Copy this file to .env.local and replace the placeholder values with your actual
# credentials from your Supabase project dashboard (Project Settings -> API).

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public API Key (anon key or publishable key)
# Both NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and NEXT_PUBLIC_SUPABASE_ANON_KEY are supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public Site URL used for OAuth callbacks and email redirect links
# In local development: http://localhost:3000
# In production: https://hackseekho.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
